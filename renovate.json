{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    { "matchManagers": ["npm", "github-actions"], "matchUpdateTypes": ["minor", "patch", "pinDigest"], "groupName": "frontend" },
    { "matchManagers": ["gomod"], "matchUpdateTypes": ["minor", "patch"], "groupName": "go" },
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true },
    { "matchPackageNames": ["github.com/wailsapp/wails/v3", "@wailsio/runtime"], "groupName": "wails", "rangeStrategy": "bump" }
  ]
}
