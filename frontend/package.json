    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
