    "@radix-ui/react-slot": "^1.1.0",
    "@wailsio/runtime": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-window": "^1.8.10",
    "srt-parser-2": "^1.2.3",
